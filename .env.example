# ─────────────────────────────────────────────────────────────────────────────
# Prediction Engine — environment template
# Copy to `.env.local` for development. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Public app URL used for building absolute links and tenant host resolution.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Root domain for subdomain-based tenant resolution in production, e.g.
# a tenant "acme" resolves at acme.predictionengine.example. Leave as localhost
# in dev where path-based /t/{slug} routing is used instead.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ── Supabase (local defaults printed by `supabase start`) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only. Bypasses RLS. MUST NOT be exposed to the browser or prefixed
# with NEXT_PUBLIC_. Used only in trusted server routes (settlement, webhooks,
# admin jobs) behind explicit authorization checks.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# ── Security ─────────────────────────────────────────────────────────────────
# Secret used to sign internal step-up / idempotency tokens.
APP_SIGNING_SECRET=replace-with-a-long-random-string

# ── Scheduled jobs (Phase 7.6) ───────────────────────────────────────────────
# Shared secret authenticating the internal scheduled endpoints
# (/api/internal/jobs/drain, /api/internal/projections/monitor). Vercel Cron
# sends it automatically as `Authorization: Bearer <CRON_SECRET>`. Until this is
# set the endpoints return 503 — they are never open. Server-only; never expose.
CRON_SECRET=replace-with-a-long-random-string

# Set true ONLY in local dev to let integration tests skip when Supabase is not
# running. MUST be false/unset in CI so critical integration suites cannot be
# silently skipped (a missing DB then fails the run instead of reporting green).
ALLOW_INTEGRATION_TEST_SKIP=false

# ── Tests + local seed scripts (IMPORTANT) ───────────────────────────────────
# `npm test` and the `scripts/seed-*.mjs` seeders DO NOT read `.env.local`.
# `.env.local` may hold PRODUCTION credentials, so reading it here could target
# the production database. Test/seed env is loaded from, in precedence order:
#     shell/CI env  >  .env.test.local (gitignored, real local keys)  >  .env.test
# `.env.test` (committed) pins the local Supabase URL; copy `.env.test.local.example`
# to `.env.test.local` and paste the local keys from `npx supabase status`.
# A guard aborts any test/seed run whose Supabase URL is not a loopback host;
# emergency-only bypass (never for production): PE_ALLOW_NONLOCAL_TEST_DB=1.

# ── Billing (Phase 7) ────────────────────────────────────────────────────────
# lemon_squeezy | mock | manual. Use `mock` locally; `lemon_squeezy` in prod.
BILLING_PROVIDER=mock
# Secret used by the mock provider to sign/verify webhooks (and internal signing).
BILLING_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Production gate for PAID Competitor Draft checkout. Keep false unless approved.
PAID_DRAFT_CHECKOUT_ENABLED=false

# Lemon Squeezy (server-only; never expose). Required when BILLING_PROVIDER=lemon_squeezy.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=true
LEMON_SQUEEZY_PLATFORM_PREMIUM_VARIANT_ID=
LEMON_SQUEEZY_CREATOR_SUPPORT_VARIANT_ID=
LEMON_SQUEEZY_PAID_DRAFT_VARIANT_ID=
