# Test-only environment (committed, safe). Loaded by the vitest harness
# (tests/integration/test-env.ts) and the local seed scripts (scripts/local-env.mjs).
#
# These values point ONLY at the local Supabase stack. Real local keys are NOT
# committed — put them in `.env.test.local` (gitignored; copy from
# `.env.test.local.example`). The test harness NEVER reads `.env.local`, which may
# hold PRODUCTION credentials, and a local-only guard aborts any run whose Supabase
# URL is not a loopback host.
#
# The local API port (54331) is set by supabase/config.toml, so this matches every
# checkout's local stack.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
BILLING_PROVIDER=mock

# Dummy (non-production) values so server code exercised by integration tests
# (serverEnv(), the internal drain route) has the required secrets. These are NOT
# real secrets — they only satisfy schema validation for the local test run.
APP_SIGNING_SECRET=test-only-signing-secret-not-a-real-secret
CRON_SECRET=test-only-cron-secret-not-a-real-secret
