# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local npm cache override (machine-specific)
.npmrc

# env
.env
.env*.local

# supabase
.branches
.temp

# editor/OS
.DS_Store

# keep the template
!.env.example
# keep committed test-only env (safe local defaults, no secrets); the real local
# keys live in the still-ignored .env.test.local
!.env.test
!.env.test.local.example

# Claude Code local settings (keep launch.json)
.claude/settings.local.json
